---
import Layout from '../layouts/Layout.astro';
import { lobs, hdiServices } from '../data/lob';
---

<Layout title="Solutions & Services" description="ktayl-solution — Nos solutions d'assurance et services sur mesure : Propriété, Transport, Construction, RCMS, Collaborateurs, Demandes spécifiques. Production, Prévention, International, Indemnisation.">

  <!-- Page header -->
  <div class="pt-32 pb-16" style="background:linear-gradient(135deg,#00233A,#00375A);">
    <div class="max-w-7xl mx-auto px-6">
      <span class="section-label">Solutions & Services</span>
      <h1 class="text-5xl font-bold text-white mb-4">Nos Solutions d'Assurance</h1>
      <p class="text-slate-300 text-xl max-w-2xl leading-relaxed">
        Découvrez l'ensemble de nos solutions d'assurance par catégorie de risque, avec les secteurs d'activité couverts et les prestations détaillées pour chaque branche.
      </p>
      <!-- LOB anchor nav -->
      <div class="flex flex-wrap gap-2 mt-8">
        {lobs.map(l => (
          <a href={`#${l.id}`}
             class="text-xs font-semibold border border-white/30 text-white hover:bg-white hover:text-[#00375A] px-3 py-1.5 rounded-full transition-colors">
            {l.name}
          </a>
        ))}
        <span class="self-center text-white/30 text-xs mx-1">|</span>
        {hdiServices.map(s => (
          <a href={`#${s.id}`}
             class="text-xs font-semibold border border-[#E8690B]/50 text-[#E8690B] hover:bg-[#E8690B] hover:text-white px-3 py-1.5 rounded-full transition-colors">
            {s.name}
          </a>
        ))}
      </div>
    </div>
  </div>

  <!-- LOB sections -->
  <div class="bg-white">
    {lobs.map((lob, i) => (
      <section
        id={lob.id}
        class={`py-20 scroll-mt-20 ${i % 2 === 1 ? 'bg-slate-50' : 'bg-white'}`}
      >
        <div class="max-w-7xl mx-auto px-6">
          <!-- LOB header -->
          <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-6 mb-12">
            <div class="flex items-start gap-5">
              <div class="w-14 h-14 rounded-xl bg-[#E8690B]/10 flex items-center justify-center text-[#E8690B] shrink-0">
                <div class="w-7 h-7">
                  <Fragment set:html={lob.icon} />
                </div>
              </div>
              <div>
                <span class="section-label">{lob.tagline}</span>
                <h2 class="text-3xl font-bold text-[#00375A]">{lob.name}</h2>
                <p class="text-slate-500 mt-3 max-w-2xl leading-relaxed">{lob.description}</p>
              </div>
            </div>
            <!-- Sector tags -->
            <div class="shrink-0">
              <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">Secteurs couverts</div>
              <div class="flex flex-wrap gap-2 max-w-xs">
                {lob.sectors.map(s => (
                  <span class="text-xs bg-[#00375A] text-white px-3 py-1 rounded-full font-medium">{s}</span>
                ))}
              </div>
            </div>
          </div>

          <!-- Service cards -->
          <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
            {lob.services.map(svc => (
              <div class="bg-white rounded-xl border border-slate-100 shadow-sm hover:shadow-md hover:border-[#E8690B]/40 transition-all duration-200 p-5">
                <div class="w-8 h-1 bg-[#E8690B] rounded mb-4"></div>
                <h3 class="font-semibold text-[#00375A] text-sm mb-2">{svc.title}</h3>
                <p class="text-xs text-slate-500 leading-relaxed">{svc.description}</p>
              </div>
            ))}
          </div>

          <!-- Divider -->
          {i < lobs.length - 1 && (
            <div class="mt-16 border-b border-slate-100"></div>
          )}
        </div>
      </section>
    ))}
  </div>

  <!-- SERVICES HDI -->
  <section class="py-24" style="background:#F4F7FA;">
    <div class="max-w-7xl mx-auto px-6">
      <div class="mb-14 max-w-2xl">
        <span class="section-label">Nos Services</span>
        <h2 class="text-4xl font-bold text-[#00375A]">Des services sur mesure sur l'ensemble de la chaîne de valeur</h2>
        <p class="text-slate-500 mt-4 text-lg leading-relaxed">
          Au-delà de l'assurance, HDI Global propose une vaste gamme de services qui accompagnent nos clients tout au long de la vie de leur contrat et de leur activité.
        </p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {hdiServices.map(svc => (
          <div id={svc.id} class="scroll-mt-20 bg-white rounded-xl border border-slate-100 shadow-sm hover:shadow-lg hover:border-[#00375A]/30 transition-all duration-200 p-7 flex flex-col gap-4">
            <div class="w-12 h-12 rounded-lg bg-[#00375A]/10 flex items-center justify-center text-[#00375A] shrink-0">
              <Fragment set:html={svc.icon} />
            </div>
            <div class="w-8 h-1 bg-[#E8690B] rounded"></div>
            <h3 class="text-xl font-bold text-[#00375A]">{svc.name}</h3>
            <p class="text-sm text-slate-500 leading-relaxed flex-1">{svc.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA bottom -->
  <section style="background:linear-gradient(135deg,#00233A,#00375A);" class="py-20">
    <div class="max-w-2xl mx-auto px-6 text-center">
      <h2 class="text-3xl font-bold text-white mb-4">Parlons de votre risque</h2>
      <p class="text-slate-300 mb-8 leading-relaxed">
        Nos experts sont disponibles sur l'ensemble de nos solutions d'assurance et services. Décrivez votre besoin et nous vous proposerons l'approche la mieux adaptée.
      </p>
      <a href="/#contact" class="btn-primary">Contacter un expert &#8594;</a>
    </div>
  </section>

</Layout>
