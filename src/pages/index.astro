---
import Layout from '../layouts/Layout.astro';
import { lobs, ktaylServices, emergingRisks } from '../data/lob';

const values = [
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" width="20" height="20"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg>`,
    title: 'Solidité Financière',
    body: "Nous portons le risque — notre propre capacité garantit chaque programme que nous souscrivons.",
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" width="20" height="20"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>`,
    title: 'Présence Internationale',
    body: 'Des polices locales admises via notre réseau dans plus de 120 pays.',
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" width="20" height="20"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>`,
    title: 'Expertise Technique',
    body: 'Souscripteurs, ingénieurs prévention et gestionnaires sinistres en interne.',
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" width="20" height="20"><polyline points="1 4 1 10 7 10"/><polyline points="23 20 23 14 17 14"/><path d="M20.49 9A9 9 0 0 0 5.64 5.64L1 10m22 4l-4.64 4.36A9 9 0 0 1 3.51 15"/></svg>`,
    title: 'Cycle Complet',
    body: "De la visite de risque et la souscription au règlement des sinistres et au renouvellement.",
  },
];

---

<Layout title="Solutions d'assurance & Services" description="ktayl-solution — Concepteur de solutions d'assurance pour les entreprises industrielles et commerciales. Propriété, Transport, Construction, RCMS, Collaborateurs et demandes spécifiques.">

  <!-- HERO -->
  <section
    class="relative min-h-screen flex flex-col justify-center overflow-hidden"
    style="background: linear-gradient(135deg, #00233A 0%, #00375A 60%, #004D7A 100%);"
  >
    <div class="absolute inset-0 opacity-5" style="background-image: url('data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='%23ffffff'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/svg%3E');"></div>
    <div class="absolute top-0 left-0 right-0 h-1 bg-[#E8690B]"></div>

    <div class="relative max-w-7xl mx-auto px-6 pt-32 pb-24">
      <div class="max-w-3xl">
        <span class="section-label">Partenaire en gestion des risques</span>
        <h1 class="text-5xl md:text-6xl lg:text-7xl font-bold text-white leading-tight mb-6">
          Solutions d'assurance<br />
          <span style="color:#E8690B;">sur mesure</span> pour<br />
          les entreprises
        </h1>
        <p class="text-xl text-slate-300 leading-relaxed mb-10 max-w-2xl">
          ktayl-solution accompagne les entreprises industrielles et commerciales, des groupes du CAC 40 aux ETI. Solutions innovantes, accompagnement à l'international et qualité de service tout au long du contrat.
        </p>
        <div class="flex flex-wrap gap-4">
          <a href="/#lob" class="btn-primary">Nos Solutions</a>
          <a href="/#services" class="btn-outline">Nos Services</a>
        </div>
      </div>

      <div class="mt-20 grid grid-cols-2 md:grid-cols-4 gap-6">
        {[
          { value: '9', label: "Solutions d'assurance" },
          { value: '6', label: 'Services sur mesure' },
          { value: '150+', label: 'Pays couverts' },
          { value: '140', label: 'Ingénieurs prévention' },
        ].map(s => (
          <div class="border-l-2 border-[#E8690B] pl-4">
            <div class="text-3xl font-bold text-white">{s.value}</div>
            <div class="text-sm text-slate-400 mt-1">{s.label}</div>
          </div>
        ))}
      </div>
    </div>

    <div class="absolute bottom-0 inset-x-0">
      <svg viewBox="0 0 1440 80" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M0 80L1440 80L1440 20C1200 80 960 0 720 40C480 80 240 0 0 20L0 80Z" fill="white"/>
      </svg>
    </div>
  </section>

  <!-- LOB GRID -->
  <section id="lob" class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-6">
      <div class="mb-14 max-w-2xl">
        <span class="section-label">Nos Solutions d'Assurance</span>
        <h2 class="text-4xl font-bold text-[#00375A]">Neuf solutions pour couvrir vos risques</h2>
        <p class="text-slate-500 mt-4 text-lg leading-relaxed">
          Par notre large gamme de branches de souscription, nous proposons des solutions sur mesure et innovantes pour chaque type de risque industriel ou commercial.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5">
        {lobs.map(lob => (
          <a href={`/services#${lob.id}`}
             class="group bg-white rounded-xl border border-slate-100 shadow-sm hover:shadow-lg hover:border-[#E8690B]/40 transition-all duration-200 p-6 flex flex-col gap-4">
            <div class="w-12 h-12 rounded-lg bg-[#E8690B]/10 flex items-center justify-center text-[#E8690B] group-hover:bg-[#E8690B] group-hover:text-white transition-all duration-200 shrink-0">
              <Fragment set:html={lob.icon} />
            </div>
            <div>
              <h3 class="text-lg font-semibold text-[#00375A] group-hover:text-[#E8690B] transition-colors">{lob.name}</h3>
              <p class="text-xs text-[#E8690B] font-medium mt-0.5">{lob.tagline}</p>
            </div>
            <p class="text-sm text-slate-500 leading-relaxed flex-1">{lob.description.slice(0, 120)}…</p>
            <div class="flex flex-wrap gap-1.5 mt-auto">
              {lob.sectors.slice(0, 2).map(s => (
                <span class="text-xs bg-slate-50 text-slate-500 border border-slate-100 rounded-full px-2.5 py-0.5">{s}</span>
              ))}
            </div>
            <span class="text-xs font-semibold text-[#E8690B] flex items-center gap-1 mt-1">
              Voir les garanties <span aria-hidden="true">&#8594;</span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- EMERGING RISKS (§34) -->
  <section id="risques" class="py-24" style="background:linear-gradient(135deg,#00233A,#00375A);">
    <div class="max-w-7xl mx-auto px-6">
      <div class="mb-14 max-w-2xl">
        <span class="section-label">Grands Risques Émergents</span>
        <h2 class="text-4xl font-bold text-white">Les risques qui transforment votre activité</h2>
        <p class="text-slate-300 mt-4 text-lg leading-relaxed">
          L'assurance industrielle doit aujourd'hui absorber simultanément plusieurs transformations majeures. Nous anticipons ces risques avec vous et structurons les couvertures adaptées — de la modélisation à l'indemnisation.
        </p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {emergingRisks.map(risk => (
          <div class="bg-white/5 border border-white/10 rounded-xl p-6 flex flex-col gap-4 hover:bg-white/10 transition-colors duration-200">
            <div class="w-12 h-12 rounded-lg bg-[#E8690B]/20 flex items-center justify-center text-[#E8690B] shrink-0">
              <Fragment set:html={risk.icon} />
            </div>
            <h3 class="text-lg font-semibold text-white">{risk.name}</h3>
            <p class="text-sm text-slate-300 leading-relaxed">{risk.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- SERVICES -->
  <section id="services" class="py-24" style="background:#F4F7FA;">
    <div class="max-w-7xl mx-auto px-6">
      <div class="mb-14 max-w-2xl">
        <span class="section-label">Nos Services</span>
        <h2 class="text-4xl font-bold text-[#00375A]">Une offre de services sur l'ensemble de la chaîne de valeur</h2>
        <p class="text-slate-500 mt-4 text-lg leading-relaxed">
          En tant que dirigeant, vous voulez vous concentrer sur la conduite de votre entreprise. Nous créons des solutions qui prennent sens sur le long terme, en partenariat avec nos clients.
        </p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {ktaylServices.map(svc => (
          <a href={`/services#${svc.id}`}
             class="group bg-white rounded-xl border border-slate-100 shadow-sm hover:shadow-lg hover:border-[#E8690B]/40 transition-all duration-200 p-6 flex flex-col gap-4">
            <div class="w-12 h-12 rounded-lg bg-[#00375A]/10 flex items-center justify-center text-[#00375A] group-hover:bg-[#00375A] group-hover:text-white transition-all duration-200 shrink-0">
              <Fragment set:html={svc.icon} />
            </div>
            <div>
              <h3 class="text-lg font-semibold text-[#00375A] group-hover:text-[#E8690B] transition-colors">{svc.name}</h3>
            </div>
            <p class="text-sm text-slate-500 leading-relaxed flex-1">{svc.description}</p>
            <span class="text-xs font-semibold text-[#E8690B] flex items-center gap-1 mt-1">
              En savoir plus <span aria-hidden="true">&#8594;</span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ABOUT -->
  <section id="about" class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-6 grid md:grid-cols-2 gap-16 items-center">
      <div>
        <span class="section-label">Qui sommes-nous</span>
        <h2 class="text-4xl font-bold text-[#00375A] mb-6">Un assureur industriel pour les risques complexes</h2>
        <p class="text-slate-600 text-lg leading-relaxed mb-6">
          ktayl-solution est né de la conviction que les grands risques industriels complexes méritent un assureur qui les comprend techniquement. Nos souscripteurs et nos ingénieurs prévention apportent une expertise approfondie en dommages, transport, construction, énergie et lignes financières.
        </p>
        <p class="text-slate-600 leading-relaxed mb-8">
          Nous souscrivons sur l'ensemble du cycle du risque — de l'analyse de l'exposition et l'ingénierie de prévention, à la structuration des contrats et la capacité, jusqu'à la gestion des sinistres, le pilotage du portefeuille et le renouvellement.
        </p>
        <div class="grid grid-cols-2 gap-5">
          {values.map(v => (
            <div class="flex gap-3 items-start">
              <div class="w-9 h-9 rounded-lg bg-[#E8690B]/10 flex items-center justify-center text-[#E8690B] shrink-0">
                <Fragment set:html={v.icon} />
              </div>
              <div>
                <div class="font-semibold text-[#00375A] text-sm">{v.title}</div>
                <div class="text-xs text-slate-500 mt-1 leading-relaxed">{v.body}</div>
              </div>
            </div>
          ))}
        </div>
      </div>
      <div class="relative rounded-2xl overflow-hidden" style="background:linear-gradient(135deg,#00375A,#004D7A); min-height:420px; padding:3rem;">
        <div class="absolute inset-0 opacity-5" style="background-image: url('data:image/svg+xml,%3Csvg width='40' height='40' viewBox='0 0 40 40' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='%23ffffff' fill-rule='evenodd'%3E%3Cpath d='M0 40L40 0H20L0 20M40 40V20L20 40'/%3E%3C/g%3E%3C/svg%3E');"></div>
        <div class="relative text-white">
          <div class="inline-flex items-center justify-center w-12 h-12 rounded-xl bg-[#E8690B] mb-6">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" width="22" height="22"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
          </div>
          <h3 class="text-2xl font-bold mb-6">Notre Approche</h3>
          <ol class="space-y-5">
            {[
              ['01', 'Analyse du Risque', "Comprendre et modéliser l'ensemble du risque avant de le tarifer."],
              ['02', 'Ingénierie de Prévention', 'Visites sur site et recommandations qui rendent le risque assurable.'],
              ['03', 'Souscription & Capacité', 'Structuration des limites et des franchises ; nous portons le risque, avec coassurance et réassurance en soutien.'],
              ['04', 'Sinistres & Renouvellement', 'Gestion proactive des sinistres et un partenariat durable pour protéger votre activité.'],
            ].map(([n, t, b]) => (
              <li class="flex gap-4">
                <span class="text-[#E8690B] font-bold text-sm w-6 shrink-0 mt-0.5">{n}</span>
                <div>
                  <div class="font-semibold text-sm">{t}</div>
                  <div class="text-xs text-slate-300 mt-0.5 leading-relaxed">{b}</div>
                </div>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </div>
  </section>

  <!-- CONTACT -->
  <section id="contact" style="background:linear-gradient(135deg,#00233A,#00375A);" class="py-24">
    <div class="max-w-3xl mx-auto px-6 text-center">
      <span class="section-label">Nous contacter</span>
      <h2 class="text-4xl font-bold text-white mb-5">Parlez à un expert</h2>
      <p class="text-slate-300 text-lg mb-12 leading-relaxed">
        Que vous souhaitiez structurer un nouveau programme, comparer vos garanties actuelles ou gérer un sinistre complexe — nous sommes à votre écoute.
      </p>
      <form
        action="https://formspree.io/f/placeholder"
        method="POST"
        class="bg-white rounded-2xl p-8 text-left shadow-2xl"
      >
        <div class="grid md:grid-cols-2 gap-5 mb-5">
          <div>
            <label class="block text-sm font-medium text-slate-700 mb-1.5">Nom complet</label>
            <input type="text" name="name" required placeholder="Jean Dupont"
              class="w-full border border-slate-200 rounded-lg px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-[#00375A]/20 focus:border-[#00375A] transition-colors" />
          </div>
          <div>
            <label class="block text-sm font-medium text-slate-700 mb-1.5">Société</label>
            <input type="text" name="company" placeholder="Votre organisation"
              class="w-full border border-slate-200 rounded-lg px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-[#00375A]/20 focus:border-[#00375A] transition-colors" />
          </div>
          <div>
            <label class="block text-sm font-medium text-slate-700 mb-1.5">E-mail</label>
            <input type="email" name="email" required placeholder="vous@entreprise.com"
              class="w-full border border-slate-200 rounded-lg px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-[#00375A]/20 focus:border-[#00375A] transition-colors" />
          </div>
          <div>
            <label class="block text-sm font-medium text-slate-700 mb-1.5">Branche d'assurance</label>
            <select name="lob"
              class="w-full border border-slate-200 rounded-lg px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-[#00375A]/20 focus:border-[#00375A] transition-colors text-slate-700">
              <option value="">Sélectionnez une branche…</option>
              {lobs.map(l => <option value={l.id}>{l.name}</option>)}
              <option value="other">Autre / Multi-branches</option>
            </select>
          </div>
        </div>
        <div class="mb-6">
          <label class="block text-sm font-medium text-slate-700 mb-1.5">Message</label>
          <textarea name="message" rows={4} required placeholder="Décrivez votre risque ou votre demande…"
            class="w-full border border-slate-200 rounded-lg px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-[#00375A]/20 focus:border-[#00375A] transition-colors resize-none"></textarea>
        </div>
        <button type="submit" class="btn-primary w-full text-center py-3.5 text-base">
          Envoyer le message &#8594;
        </button>
        <p class="text-xs text-slate-400 mt-4 text-center">Nous répondons sous un jour ouvré.</p>
      </form>
    </div>
  </section>

</Layout>
