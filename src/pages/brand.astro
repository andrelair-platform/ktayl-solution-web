---
import Layout from '../layouts/Layout.astro';

const colors = [
  { name: 'Marine', hex: '#00375A', role: 'Marque principale — titres, fonds, icônes', dark: true },
  { name: 'Marine Foncé', hex: '#00233A', role: 'Contexte profond — dégradés hero, pied de page', dark: true },
  { name: 'Orange Signal', hex: '#E8690B', role: "Accent — CTA, branche basse du K, mises en avant", dark: false },
  { name: 'Or Chaud', hex: '#F5A623', role: "État survol de l'Orange Signal, accent secondaire", dark: false },
  { name: 'Slate 500', hex: '#64748B', role: 'Texte courant, descriptions', dark: false },
  { name: 'Slate 100', hex: '#F1F5F9', role: 'Fonds de cartes, fonds de sections', dark: false },
  { name: 'Blanc', hex: '#FFFFFF', role: 'Surfaces, texte inversé sur fond sombre', dark: false, border: true },
];

const typeScale = [
  { label: 'Display', size: '4.5rem / 72px', weight: '700', use: 'H1 hero uniquement', sample: 'Risques Complexes' },
  { label: 'Heading 1', size: '3rem / 48px', weight: '700', use: 'H2 de section', sample: "Neuf Branches d'Assurance" },
  { label: 'Heading 2', size: '1.875rem / 30px', weight: '700', use: 'Titres de cartes, H2 services', sample: 'Marine & Aviation' },
  { label: 'Label', size: '0.75rem / 12px', weight: '700', use: 'Labels de section, majuscules', sample: 'NOS ASSURANCES' },
  { label: 'Body Large', size: '1.125rem / 18px', weight: '400', use: "Paragraphes d'introduction", sample: 'Assurance industrielle pour les grands risques mondiaux.' },
  { label: 'Body', size: '0.875rem / 14px', weight: '400', use: 'Corps de carte, descriptions', sample: "Analyse de bout en bout de l'exposition supply chain et structuration des garanties." },
  { label: 'Caption', size: '0.75rem / 12px', weight: '500', use: 'Tags, badges, métadonnées', sample: 'Transport & Logistique · Exploitants Portuaires' },
];
---

<Layout title="Identité de Marque" description="Système d'identité visuelle de ktayl-solution.">
  <div class="pt-24 min-h-screen bg-[#F4F7FA]">
    <div class="max-w-5xl mx-auto px-6 py-16">

      <!-- Header -->
      <div class="mb-16">
        <span class="section-label">Référence Interne</span>
        <h1 class="text-4xl font-bold text-[#00375A] mb-3">Système d'Identité Visuelle</h1>
        <p class="text-slate-500 text-lg">Charte de marque ktayl-solution — logo, couleurs, typographie et règles d'usage.</p>
      </div>

      <!-- ── LOGO ── -->
      <section class="mb-16">
        <h2 class="text-xl font-bold text-[#00375A] mb-6 pb-3 border-b border-slate-200">Logo</h2>
        <div class="grid md:grid-cols-2 gap-5">

          <!-- Primary (on white) -->
          <div class="bg-white rounded-xl border border-slate-100 p-10 flex flex-col items-center gap-4 shadow-sm">
            <img src="/logo-full.svg" alt="logo complet ktayl-solution" class="h-16"/>
            <span class="text-xs text-slate-400 font-medium uppercase tracking-wider">Principal — sur blanc</span>
          </div>

          <!-- Inverted (on navy) -->
          <div class="rounded-xl p-10 flex flex-col items-center gap-4 shadow-sm" style="background:#00375A;">
            <div class="flex items-center gap-4">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 72" width="36" height="41" aria-hidden="true">
                <defs><clipPath id="bc-shield"><path d="M8 4h48v24c0 17-10 32-24 40C18 60 8 45 8 28V4z"/></clipPath></defs>
                <path d="M8 4h48v24c0 17-10 32-24 40C18 60 8 45 8 28V4z" fill="white" fill-opacity="0.15"/>
                <rect x="8" y="4" width="48" height="4" fill="#E8690B"/>
                <g clip-path="url(#bc-shield)">
                  <rect x="16" y="12" width="9" height="50" rx="2" fill="white"/>
                  <line x1="24" y1="36" x2="52" y2="12" stroke="white" stroke-width="9" stroke-linecap="round"/>
                  <line x1="24" y1="36" x2="50" y2="60" stroke="#E8690B" stroke-width="9" stroke-linecap="round"/>
                </g>
              </svg>
              <div>
                <div class="text-white font-bold text-2xl tracking-tight leading-none">ktayl-solution</div>
                <div class="text-[#E8690B] text-xs font-semibold tracking-widest mt-1">ASSUREUR INDUSTRIEL & GRANDS RISQUES</div>
              </div>
            </div>
            <span class="text-xs text-white/40 font-medium uppercase tracking-wider">Inversé — sur marine</span>
          </div>

          <!-- Mark only -->
          <div class="bg-white rounded-xl border border-slate-100 p-10 flex flex-col items-center gap-4 shadow-sm">
            <img src="/logo-mark.svg" alt="blason ktayl-solution" class="h-20"/>
            <span class="text-xs text-slate-400 font-medium uppercase tracking-wider">Blason — seul</span>
          </div>

          <!-- Mark on dark -->
          <div class="rounded-xl p-10 flex flex-col items-center gap-6 shadow-sm" style="background:linear-gradient(135deg,#00233A,#00375A);">
            <div class="flex items-center gap-6">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 72" width="52" height="59" aria-hidden="true">
                <defs><clipPath id="bc-shield-lg"><path d="M8 4h48v24c0 17-10 32-24 40C18 60 8 45 8 28V4z"/></clipPath></defs>
                <path d="M8 4h48v24c0 17-10 32-24 40C18 60 8 45 8 28V4z" fill="white" fill-opacity="0.1"/>
                <rect x="8" y="4" width="48" height="4" fill="#E8690B"/>
                <g clip-path="url(#bc-shield-lg)">
                  <rect x="16" y="12" width="9" height="50" rx="2" fill="white"/>
                  <line x1="24" y1="36" x2="52" y2="12" stroke="white" stroke-width="9" stroke-linecap="round"/>
                  <line x1="24" y1="36" x2="50" y2="60" stroke="#E8690B" stroke-width="9" stroke-linecap="round"/>
                </g>
              </svg>
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 72" width="36" height="41" aria-hidden="true">
                <defs><clipPath id="bc-shield-sm"><path d="M8 4h48v24c0 17-10 32-24 40C18 60 8 45 8 28V4z"/></clipPath></defs>
                <path d="M8 4h48v24c0 17-10 32-24 40C18 60 8 45 8 28V4z" fill="white" fill-opacity="0.1"/>
                <rect x="8" y="4" width="48" height="4" fill="#E8690B"/>
                <g clip-path="url(#bc-shield-sm)">
                  <rect x="16" y="12" width="9" height="50" rx="2" fill="white"/>
                  <line x1="24" y1="36" x2="52" y2="12" stroke="white" stroke-width="9" stroke-linecap="round"/>
                  <line x1="24" y1="36" x2="50" y2="60" stroke="#E8690B" stroke-width="9" stroke-linecap="round"/>
                </g>
              </svg>
            </div>
            <span class="text-xs text-white/40 font-medium uppercase tracking-wider">Comparaison d'échelle — sur fond sombre</span>
          </div>
        </div>

        <!-- Logo anatomy -->
        <div class="mt-6 bg-white rounded-xl border border-slate-100 p-8 shadow-sm">
          <h3 class="text-sm font-semibold text-[#00375A] mb-5">Anatomie du blason</h3>
          <div class="flex flex-col md:flex-row gap-8 items-center">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 72" width="100" height="113" aria-hidden="true">
              <defs><clipPath id="bc-anat"><path d="M8 4h48v24c0 17-10 32-24 40C18 60 8 45 8 28V4z"/></clipPath></defs>
              <path d="M8 4h48v24c0 17-10 32-24 40C18 60 8 45 8 28V4z" fill="#00375A"/>
              <rect x="8" y="4" width="48" height="4" fill="#E8690B"/>
              <g clip-path="url(#bc-anat)">
                <rect x="16" y="12" width="9" height="50" rx="2" fill="white"/>
                <line x1="24" y1="36" x2="52" y2="12" stroke="white" stroke-width="9" stroke-linecap="round"/>
                <line x1="24" y1="36" x2="50" y2="60" stroke="#E8690B" stroke-width="9" stroke-linecap="round"/>
              </g>
            </svg>
            <div class="grid grid-cols-1 gap-3 text-sm flex-1">
              <div class="flex items-center gap-3">
                <div class="w-4 h-4 rounded" style="background:#00375A;"></div>
                <span class="font-medium text-[#00375A]">Forme de blason</span>
                <span class="text-slate-400 text-xs">— Protection, stabilité, la promesse fondamentale de l'assurance</span>
              </div>
              <div class="flex items-center gap-3">
                <div class="w-4 h-4 rounded bg-white border border-slate-200"></div>
                <span class="font-medium text-[#00375A]">Barre verticale du K + branche haute</span>
                <span class="text-slate-400 text-xs">— Expertise ancrée, clarté du conseil</span>
              </div>
              <div class="flex items-center gap-3">
                <div class="w-4 h-4 rounded" style="background:#E8690B;"></div>
                <span class="font-medium text-[#00375A]">Branche basse du K (Orange Signal)</span>
                <span class="text-slate-400 text-xs">— Action, énergie, élan</span>
              </div>
              <div class="flex items-center gap-3">
                <div class="w-16 h-2 rounded" style="background:#E8690B;"></div>
                <span class="font-medium text-[#00375A]">Barre orange supérieure</span>
                <span class="text-slate-400 text-xs">— Précision, différenciation, règle d'accent</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Clear space -->
        <div class="mt-5 bg-white rounded-xl border border-slate-100 p-8 shadow-sm">
          <h3 class="text-sm font-semibold text-[#00375A] mb-4">Zone de protection & taille minimale</h3>
          <div class="flex flex-wrap gap-10 items-end">
            <div class="text-center">
              <div class="inline-flex p-4 border border-dashed border-[#E8690B]/40 rounded">
                <img src="/logo-mark.svg" alt="" class="h-14"/>
              </div>
              <p class="text-xs text-slate-400 mt-2">Zone de protection = 1× la hauteur du blason sur tous les côtés</p>
            </div>
            <div class="text-sm text-slate-500 leading-relaxed max-w-xs">
              <p><strong class="text-[#00375A]">Taille minimale digitale :</strong> 24px de hauteur pour le blason, 160px de largeur pour le logo complet.</p>
              <p class="mt-2"><strong class="text-[#00375A]">Jamais :</strong> étirer, pivoter, recolorer, ou placer sur un fond de teinte moyenne sans contraste suffisant.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- ── COLOURS ── -->
      <section class="mb-16">
        <h2 class="text-xl font-bold text-[#00375A] mb-6 pb-3 border-b border-slate-200">Système de Couleurs</h2>
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
          {colors.map(c => (
            <div class="rounded-xl overflow-hidden shadow-sm border border-slate-100">
              <div
                class="h-20"
                style={`background:${c.hex}; ${c.border ? 'border:1px solid #e2e8f0;' : ''}`}
              ></div>
              <div class="bg-white p-3">
                <div class="font-semibold text-[#00375A] text-sm">{c.name}</div>
                <div class="text-xs font-mono text-slate-500 mt-0.5">{c.hex}</div>
                <div class="text-xs text-slate-400 mt-1 leading-snug">{c.role}</div>
              </div>
            </div>
          ))}
        </div>

        <!-- Gradient combos -->
        <div class="mt-5 grid md:grid-cols-2 gap-4">
          <div class="rounded-xl overflow-hidden shadow-sm border border-slate-100">
            <div class="h-16" style="background:linear-gradient(135deg,#00233A,#004D7A);"></div>
            <div class="bg-white p-3">
              <div class="font-semibold text-[#00375A] text-sm">Dégradé hero</div>
              <div class="text-xs font-mono text-slate-500 mt-0.5">#00233A → #004D7A (135deg)</div>
              <div class="text-xs text-slate-400 mt-1">Sections hero, bandeaux CTA, surimpressions sombres</div>
            </div>
          </div>
          <div class="rounded-xl overflow-hidden shadow-sm border border-slate-100">
            <div class="h-16" style="background:#F4F7FA;"></div>
            <div class="bg-white p-3">
              <div class="font-semibold text-[#00375A] text-sm">Teinte de surface</div>
              <div class="text-xs font-mono text-slate-500 mt-0.5">#F4F7FA</div>
              <div class="text-xs text-slate-400 mt-1">Fonds de sections alternés</div>
            </div>
          </div>
        </div>
      </section>

      <!-- ── TYPOGRAPHY ── -->
      <section class="mb-16">
        <h2 class="text-xl font-bold text-[#00375A] mb-2 pb-3 border-b border-slate-200">Typographie</h2>
        <p class="text-slate-500 text-sm mb-6">Police : <strong class="text-[#00375A]">Inter</strong> (Google Fonts). Graisses : 400 Regular · 500 Medium · 600 SemiBold · 700 Bold. Interlettrage des titres : −0,02em.</p>
        <div class="bg-white rounded-xl border border-slate-100 shadow-sm overflow-hidden">
          {typeScale.map((t, i) => (
            <div class={`px-6 py-5 flex flex-col md:flex-row md:items-center gap-3 ${i < typeScale.length - 1 ? 'border-b border-slate-100' : ''}`}>
              <div class="w-28 shrink-0">
                <div class="text-xs font-semibold text-[#E8690B]">{t.label}</div>
                <div class="text-xs text-slate-400 mt-0.5">{t.size}</div>
                <div class="text-xs text-slate-400">w{t.weight}</div>
              </div>
              <div class="flex-1 min-w-0">
                <div
                  class="text-[#00375A] truncate"
                  style={`font-size:clamp(0.75rem, ${t.label === 'Display' ? '2rem' : t.label === 'Heading 1' ? '1.5rem' : t.label === 'Heading 2' ? '1.2rem' : '1rem'}, ${t.size.split(' ')[0]}); font-weight:${t.weight}; letter-spacing:${t.weight === '700' ? '-0.02em' : t.label === 'Label' ? '0.1em' : 'normal'}; text-transform:${t.label === 'Label' ? 'uppercase' : 'none'};`}
                >{t.sample}</div>
              </div>
              <div class="text-xs text-slate-400 shrink-0">{t.use}</div>
            </div>
          ))}
        </div>
      </section>

      <!-- ── COMPONENTS ── -->
      <section class="mb-16">
        <h2 class="text-xl font-bold text-[#00375A] mb-6 pb-3 border-b border-slate-200">Composants UI</h2>
        <div class="bg-white rounded-xl border border-slate-100 shadow-sm p-8 space-y-8">

          <!-- Buttons -->
          <div>
            <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-3">Boutons</div>
            <div class="flex flex-wrap gap-3 items-center">
              <a href="#" class="btn-primary">Action principale</a>
              <a href="#" class="btn-outline" style="border-color:#00375A; color:#00375A; background:white;">Contour (fond clair)</a>
              <a href="#" class="btn-outline">Contour (fond sombre)</a>
              <a href="#" class="text-xs font-semibold text-[#E8690B] flex items-center gap-1">Lien texte &#8594;</a>
            </div>
          </div>

          <!-- Section label -->
          <div>
            <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-3">Label de section</div>
            <span class="section-label">Nos Assurances</span>
            <p class="text-xs text-slate-400 mt-1">0,75rem · graisse 700 · interlettrage 0,12em · couleur Orange Signal</p>
          </div>

          <!-- Tags -->
          <div>
            <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-3">Tags secteurs</div>
            <div class="flex flex-wrap gap-2">
              <span class="text-xs bg-[#00375A] text-white px-3 py-1 rounded-full font-medium">Transport & Logistique</span>
              <span class="text-xs bg-[#E8690B]/10 text-[#E8690B] border border-[#E8690B]/20 px-3 py-1 rounded-full font-medium">Marine</span>
              <span class="text-xs bg-slate-50 text-slate-500 border border-slate-100 rounded-full px-2.5 py-0.5">Exploitants Portuaires</span>
            </div>
          </div>

          <!-- Icon container -->
          <div>
            <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-3">Conteneurs d'icônes</div>
            <div class="flex gap-3 items-center">
              <div class="w-12 h-12 rounded-lg bg-[#E8690B]/10 flex items-center justify-center text-[#E8690B]">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" width="24" height="24"><circle cx="12" cy="5" r="2"/><path d="M12 7v14"/><path d="M5 12h14"/><path d="M5 12c0 3.87 3.13 7 7 7s7-3.13 7-7"/></svg>
              </div>
              <div class="w-12 h-12 rounded-lg bg-[#E8690B] flex items-center justify-center text-white">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" width="24" height="24"><circle cx="12" cy="5" r="2"/><path d="M12 7v14"/><path d="M5 12h14"/><path d="M5 12c0 3.87 3.13 7 7 7s7-3.13 7-7"/></svg>
              </div>
              <div class="w-11 h-11 rounded-lg bg-[#00375A]/10 flex items-center justify-center text-[#00375A]">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" width="22" height="22"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
              </div>
              <p class="text-xs text-slate-400">Par défaut · Survol/actif · Icône plateforme</p>
            </div>
          </div>
        </div>
      </section>

      <!-- ── TONE ── -->
      <section class="mb-16">
        <h2 class="text-xl font-bold text-[#00375A] mb-6 pb-3 border-b border-slate-200">Voix de la Marque</h2>
        <div class="grid md:grid-cols-2 gap-5">
          <div class="bg-white rounded-xl border border-slate-100 shadow-sm p-6">
            <div class="text-[#E8690B] font-bold text-sm uppercase tracking-wider mb-4">Nous sommes</div>
            <ul class="space-y-3 text-sm text-slate-600">
              {[
                ['Précis', "Nous disons « analyse de l'exposition » et non « vérification du risque ». Le vocabulaire technique signale l'expertise."],
                ['Affirmés', 'Nous affirmons — sans détour. « Nous souscrivons des programmes complexes » et non « nous pouvons vous aider ».'],
                ['Directs', 'Des phrases courtes. Pas de remplissage. Nos clients sont des professionnels — traitons-les comme tels.'],
                ['Internationaux', 'Paris et un réseau international dans plus de 120 pays. Notre langage reflète un assureur international.'],
              ].map(([t, d]) => (
                <li>
                  <div class="font-semibold text-[#00375A]">{t}</div>
                  <div class="text-xs text-slate-400 mt-0.5 leading-relaxed">{d}</div>
                </li>
              ))}
            </ul>
          </div>
          <div class="bg-white rounded-xl border border-slate-100 shadow-sm p-6">
            <div class="text-slate-400 font-bold text-sm uppercase tracking-wider mb-4">Nous ne sommes pas</div>
            <ul class="space-y-3 text-sm text-slate-600">
              {[
                ['Promotionnels', 'Pas de superlatifs, pas de promesses creuses. « Meilleur » et « leader » appartiennent aux communiqués de presse.'],
                ['Jargonneux', "Techniques quand la précision l'exige — simples quand la clarté prime."],
                ['Familiers', "Pas d'argot, pas de tutoiement dans les textes. La chaleur par la clarté, non par la familiarité."],
                ['Passifs', 'Voix active uniquement. « Nous souscrivons votre programme » — jamais « votre programme sera souscrit ».'],
              ].map(([t, d]) => (
                <li>
                  <div class="font-semibold text-slate-500">{t}</div>
                  <div class="text-xs text-slate-400 mt-0.5 leading-relaxed">{d}</div>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </section>

      <!-- ── DOWNLOADS ── -->
      <section>
        <h2 class="text-xl font-bold text-[#00375A] mb-6 pb-3 border-b border-slate-200">Téléchargement des Ressources</h2>
        <div class="grid md:grid-cols-3 gap-4">
          {[
            { href: '/favicon.svg', label: 'Favicon', desc: "SVG · équivalent 32×32 · icône d'onglet", file: 'favicon.svg' },
            { href: '/logo-mark.svg', label: 'Blason', desc: 'SVG · 64×72 · symbole seul', file: 'logo-mark.svg' },
            { href: '/logo-full.svg', label: 'Logo Complet', desc: 'SVG · 320×72 · blason + nom + signature', file: 'logo-full.svg' },
          ].map(a => (
            <a href={a.href} download={a.file}
               class="bg-white rounded-xl border border-slate-100 shadow-sm p-5 hover:border-[#E8690B]/40 hover:shadow-md transition-all group">
              <div class="text-lg font-bold text-[#00375A] group-hover:text-[#E8690B] transition-colors">{a.label}</div>
              <div class="text-xs text-slate-400 mt-1 leading-relaxed">{a.desc}</div>
              <div class="text-xs font-semibold text-[#E8690B] mt-3 flex items-center gap-1">Télécharger le SVG &#8595;</div>
            </a>
          ))}
        </div>
        <p class="text-xs text-slate-400 mt-4">Toutes les ressources sont au format vectoriel SVG — redimensionnables sans perte de qualité. Pour l'impression, ouvrez-les dans Illustrator ou Figma et exportez en PDF/EPS.</p>
      </section>

    </div>
  </div>
</Layout>
